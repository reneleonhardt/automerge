{
  "compilerOptions": {
    "noImplicitAny": true,
    "strict": true,
    "allowJs": false,
    "esModuleInterop": true,
    "lib": ["dom", "esnext.asynciterable", "es2017", "es2016", "es2015"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2018",
    "types": ["mocha", "node"]
  },
  "include": ["test/**/*.mts"],
  "exclude": ["dist/**/*", "examples/**/*"]
}
